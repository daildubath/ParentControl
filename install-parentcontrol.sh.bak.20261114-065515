# ------------------------------------------------------------------------------
# Parse Module-Specific Flags
# ------------------------------------------------------------------------------
parse_perms_args() {
    pc_parse_common_flags "$@"
    set -- "${PC_REMAINING_ARGS[@]}"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --action)
                PERMS_ACTION="${2:-}"
                shift 2
                ;;
            --path)
                TARGET_PATH="${2:-}"
                shift 2
                ;;
