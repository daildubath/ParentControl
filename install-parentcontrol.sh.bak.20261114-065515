main() {
    parse_ports_args "$@"
    pc_require_root
    pc_verify_mint

    case "$PORTS_ACTION" in
        block|add)
            handle_block
            ;;
        unblock|remove)
            handle_unblock
            ;;
        list)
            handle_list
            ;;
        apply)
            handle_apply
            ;;
        *)
            pc_emit_error "Unsupported action '${PORTS_ACTION}' (expected: block, unblock, list, apply)." 2
            exit 2
            ;;
    esac
}

